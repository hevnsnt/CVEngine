# Copy this file to .env and edit it: cp .env.example .env
# Nothing here has to be edited: ./scripts/init-env.sh (run by the installer and by make) generates the passwords marked
# "change-me" and replaces the example DOMAIN_NAME with this machine's address. Set your own only if you want to.

#
# General
#
COMPOSE_PROJECT_NAME=rengine

#
# SSL specific configuration (used by `make certs`)
#
AUTHORITY_NAME=CVEngine
AUTHORITY_PASSWORD=change-me
COMPANY=CVEngine
DOMAIN_NAME=cvengine.example.com
COUNTRY_CODE=US
STATE=change-me
CITY=change-me

#
# Database configurations
#
POSTGRES_DB=rengine
POSTGRES_USER=rengine
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
POSTGRES_HOST=db

#
# Optional (see docs/CONFIGURATION.md). Uncomment to use.
#
# CVENGINE_CSRF_TRUSTED_ORIGINS=https://scanner.example.com
# CVENGINE_ALLOW_PRIVATE_TARGETS=1
# Addresses the web container sees connecting to it whose X-Forwarded-For is believed (the real client address for the IP allowlist).
# The default already covers Docker's networks, so leave it unset for the bundled proxy or a proxy on this host. Only ever ADD to it
# (172.16.0.0/12,203.0.113.0/24); replacing it with your proxy's own network makes every request look like it comes from Docker.
# CVENGINE_TRUSTED_PROXIES=172.16.0.0/12
# CELERY_MEM_LIMIT=4g
# Scan a Tailscale tailnet (docs/TAILSCALE.md): turn the optional tailscale service on, then put its auth key in .env.tailscale (not here:
# every variable in this file reaches every container) as a line TS_AUTHKEY=tskey-auth-...
# COMPOSE_PROFILES=tailscale
# TAILSCALE_HOSTNAME=cvengine
# Needed when TS_AUTHKEY is an OAuth client secret or the auth key was not created with a tag:
# TAILSCALE_EXTRA_ARGS=--advertise-tags=tag:cvengine
# Scan with OpenVAS / Greenbone (docs/OPENVAS.md), optional and off by default. The profile needs about 4 GB of RAM beyond cvENGINE, 2 CPUs and 25 GB of disk,
# and downloads the feeds for a long time on its first start. Then choose what to scan in Administration > OpenVAS: it starts the containers (through the host updater), makes the login and loads the feeds by itself. With both: COMPOSE_PROFILES=tailscale,openvas
# COMPOSE_PROFILES=openvas
# CVENGINE_OPENVAS_MIN_AVAILABLE_MB=3072

#
# First admin account (used by `make admin`)
#
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
# Leave the password empty: `make admin` generates one and prints it once. Set it only to choose your own.
DJANGO_SUPERUSER_PASSWORD=

# Encrypts the stored API keys, webhook URLs and two-step sign-in seeds. Generated on first start; keep it with your backups of .env
# (a restored database needs it, together with web/secret for older rows), but in a different place from the dumps: a dump stored beside its
# key is readable by anyone who can read the backup. Rotate with: make rotate-field-key  (see docs/CONFIGURATION.md)
CVENGINE_FIELD_KEY=
CVENGINE_FIELD_KEY_PREVIOUS=

# Password of the Redis broker. Generated on a first start; an older installation turns it on with: make redis-auth
# Letters and digits only (it is part of a connection URL).
REDIS_PASSWORD=

# Optional: a free VulnCheck community key adds VulnCheck KEV to the exploited-in-the-wild sources (docs/CONFIGURATION.md).
CVENGINE_VULNCHECK_API_KEY=
