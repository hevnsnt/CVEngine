# Copy this file to .env and edit it: cp .env.example .env
# Change every value marked "change-me" before the first start.

#
# General
#
COMPOSE_PROJECT_NAME=rengine

#
# SSL specific configuration (used by `make certs`)
#
AUTHORITY_NAME=CVEngine
AUTHORITY_PASSWORD=change-me
COMPANY=CVEngine
DOMAIN_NAME=cvengine.example.com
COUNTRY_CODE=US
STATE=change-me
CITY=change-me

#
# Database configurations
#
POSTGRES_DB=rengine
POSTGRES_USER=rengine
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
POSTGRES_HOST=db

#
# Optional (see docs/CONFIGURATION.md). Uncomment to use.
#
# CVENGINE_CSRF_TRUSTED_ORIGINS=https://scanner.example.com
# CVENGINE_ALLOW_PRIVATE_TARGETS=1
# CVENGINE_TRUSTED_PROXIES=172.16.0.0/12
# CELERY_MEM_LIMIT=4g

#
# First admin account (used by `make username`)
#
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me
