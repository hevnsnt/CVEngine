# Hosted mode only (hosted/README.md). Stock file: no entries, so hosted mode is OFF and every request is handled exactly as before.
#
# It is included inside `map $http_x_cvl_edge_auth $cvl_edge_ok { ... }` at the top of rengine.conf. On a hosted server the file is generated by
# hosted/gen-edge-auth.sh (never edit it by hand) and mounted over /etc/nginx/edge-auth.conf by docker-compose.hosted.yml; it holds:
#
#   default 0;
#   "<current edge secret>" 1;
#   "<previous edge secret>" 1;   # only while a rotation overlaps
#
# Do not edit this file (an update would stop on the change).
