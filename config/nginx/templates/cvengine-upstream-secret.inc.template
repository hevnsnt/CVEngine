# Rendered by the nginx image at start (envsubst, /docker-entrypoint.d/20-envsubst-on-templates.sh) into /etc/nginx/conf.d/cvengine-upstream-secret.inc,
# which the map $cvengine_upstream_secret_match in cvengine.conf includes. CVENGINE_UPSTREAM_SECRET comes from the proxy's environment (docker-compose.yml):
# 32 to 256 letters, digits, "-" or "_". Empty or shorter: no request is ever vouched for, as on a plain install.
"k${CVENGINE_UPSTREAM_SECRET}"  1;
