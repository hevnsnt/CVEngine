        "properties": {
          "host": {
            "type": "string",
            "maxLength": 260
          },
          "ip": {
            "type": "string",
            "maxLength": 60
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "scheme": {
            "enum": [
              "http",
              "https"
            ]
          }
        }
      },
      "http_probe": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "probes": {
            "type": "array",
            "maxItems": 300,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "host": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 260
                },
                "probe": {
                  "enum": [
                    "headers-root",
                    "error-page",
                    "nginx-variants",
                    "nextjs-version",
                    "html-libraries",
                    "drupal-changelog",
                    "joomla-manifest",
                    "magento-version",
                    "robots-txt",
                    "wordpress-detect"
                  ]
                },
                "base": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300,
                  "description": "scheme://host[:port] of that host"
                },
                "allowed": {
                  "type": "array",
                  "maxItems": 20,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 260
                  },
                  "description": "the names a redirect may lead to (the host's apex and www)"
                }
              },
              "required": [
                "id",
                "host",
                "probe",
                "base",
                "allowed"
              ]
            },
            "minItems": 1
          },
          "scope": {
            "$ref": "#/$defs/probe_scope"
          }
        },
        "required": [
          "probes",
          "scope"
        ]
      },
      "dns_resolve": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "names": {
            "type": "array",
            "maxItems": 500,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253
            },
            "minItems": 1
          },
          "scope": {
            "$ref": "#/$defs/probe_scope"
          }
        },
        "required": [
          "names",
          "scope"
        ]
      }
    },
    "probe_scope": {
      "type": "object",
      "description": "What a probe task may touch, computed by the server when it builds the task (exclusions, archived hosts, the targets' name scope, a bug bounty program's scope, the hosts a page may read scripts from, the private addresses the project authorised) and enforced by the scanner at every hop, redirects and script reads included, on top of its own floor. A name is allowed when it is in hosts or equal to or under a domain, and is not excluded; an address must also pass the floor, blocked and the private rule. Missing or malformed, it allows nothing.",
      "required": [
        "hosts",
        "domains",
        "excluded",
        "excluded_trees",
        "private",
        "addresses",
        "blocked"
      ],
      "additionalProperties": false,
      "properties": {
        "hosts": {
          "type": "array",
          "maxItems": 5000,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 260
          }
        },
        "domains": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253
          }
        },
        "excluded": {
          "type": "array",
          "maxItems": 5000,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 260
          }
        },
        "excluded_trees": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 260
          }
        },
        "private": {
          "type": "boolean",
          "description": "the server allows private addresses (a lab install); an external Sentinel still never reaches them, and an internal one only with this"
        },
        "addresses": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "description": "private addresses the project authorised (its own tailnet devices), reached only when asked for as themselves"
        },
        "blocked": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "description": "CIDR ranges the server never scans"
        }
      }
    }
  }
