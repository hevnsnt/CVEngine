      },
      "secrets_scan": {
        "type": "object",
        "required": [
          "hosts",
          "scope",
          "limits",
          "validate"
        ],
        "additionalProperties": false,
        "description": "A batch of web hosts whose pages and own scripts the Sentinel fetches (bounded, anonymous, same origin) and scans with Kingfisher, detection only (--no-validate) unless validate is true. validate is only ever true in a task for the built-in scanner, for a project that opted in (cveFeed.secrets_validation): the second Kingfisher pass then loads validate_rules only, and only when the scanner's Kingfisher is validate_kingfisher. rules_bundle_sha256 names the instance's custom rules (GET /api/v1/sentinel/secret-rules/bundle), null when there are none.",
        "properties": {
          "hosts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 25,
            "items": {
              "type": "object",
              "required": [
                "host",
                "urls"
              ],
              "additionalProperties": false,
              "properties": {
                "host": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 260
                },
                "urls": {
                  "type": "array",
                  "maxItems": 20,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  }
                },
                "script_urls": {
                  "type": "array",
                  "maxItems": 8,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  }
                }
              }
            }
          },
          "scope": {
            "type": "object",
            "required": [
              "names"
            ],
            "additionalProperties": false,
            "properties": {
              "names": {
                "type": "array",
                "maxItems": 25,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 260
                },
                "description": "the only hosts any fetch may reach: the batch's own"
              },
              "exclusions": {
                "type": "array",
                "maxItems": 500,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 260
                }
              }
            }
          },
          "limits": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "max_scripts_per_host": {
                "type": "integer",
                "minimum": 0,
                "maximum": 8
              },
              "max_script_bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2097152
              },
              "max_map_bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 8388608
              },
              "max_total_bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 33554432
              },
              "follow_sourcemaps": {
                "type": "boolean"
              }
            }
          },
          "validate": {
            "type": "boolean"
          },
          "validate_rules": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._:/-]{0,119}$"
            }
          },
          "validate_kingfisher": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 20
          },
          "rules_bundle_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "skip_words": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          "skip_regex": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        }
      }
    }
