              "read_only",
              "bundle_sha256"
            ],
            "properties": {
              "rev": {
                "type": "string",
                "maxLength": 80
              },
              "read_only": {
                "type": "boolean"
              },
              "bundle_sha256": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      },
      "testssl": {
        "type": "object",
        "required": [
          "host",
          "ip",
          "port"
        ],
        "additionalProperties": false,
        "properties": {
          "host": {
            "type": "string",
            "maxLength": 260
          },
          "ip": {
            "type": "string",
            "maxLength": 60
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "starttls": {
            "type": "string",
            "maxLength": 20
          }
        }
      },
      "nmap_udp": {
        "type": "object",
        "required": [
          "address"
        ],
        "additionalProperties": false,
        "properties": {
          "address": {
            "type": "string",
            "maxLength": 60
          }
        }
      },
      "wpscan": {
        "type": "object",
        "required": [
          "url",
          "token"
        ],
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 2048
          },
          "token": {
            "type": "string",
            "maxLength": 256,
            "description": "the project's WPScan API token, for this one run; the server replaces it with *** once the task ends"
          }
        }
      },
      "discover": {
        "type": "object",
        "required": [
          "cidr"
        ],
        "additionalProperties": false,
        "properties": {
          "cidr": {
            "type": "string",
            "maxLength": 64
          }
        }
      },
      "openvas": {
        "type": "object",
        "required": [
          "hosts",
          "excluded_families",
          "max_hours",
          "preferences"
        ],
        "additionalProperties": false,
        "properties": {
          "hosts": {
            "type": "object",
            "description": "address to host name",
            "additionalProperties": {
              "type": "string",
              "maxLength": 260
            }
          },
          "excluded_families": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 100
            }
          },
          "max_hours": {
            "type": "number",
            "minimum": 0
          },
          "preferences": {
            "type": "object"
          }
        }
      },
      "waf": {
        "type": "object",
        "required": [
          "host",
          "ip",
          "port",
          "scheme"
        ],
        "additionalProperties": false,
        "properties": {
          "host": {
            "type": "string",
            "maxLength": 260
          },
          "ip": {
            "type": "string",
            "maxLength": 60
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "scheme": {
            "enum": [
              "http",
              "https"
            ]
          }
        }
      }
    }
  }
}
