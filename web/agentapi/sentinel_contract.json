{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hevnsnt/CVEngine/agentapi/sentinel_contract.json",
  "title": "cvENGINE Sentinel result contract",
  "description": "Both halves of the exchange between cvENGINE and a Sentinel. $defs/targets is what the server hands a Sentinel for each task kind (the task's target); $defs/results is what a Sentinel sends to POST /api/v1/sentinel/tasks/{id}/result. The server clips and validates every result anyway (agentapi.sentinel_broker.clean_result); this file is what a correct client keeps to, so the server never has to. Bounds are asserted equal to the server's own limits, and every target the server builds is validated against it, by tests/test_sentinel_contract.py. Bump contract_version (and say so in CHANGELOG) for any change a client must follow.",
  "contract_version": 3,
  "min_supported_contract_version": 1,
  "kind_since": {"nmap": 1, "naabu": 1, "nuclei_light": 1, "nuclei_targeted": 1, "nuclei_deep": 1, "testssl": 1, "nmap_udp": 1, "wpscan": 1, "discover": 1, "openvas": 1, "waf": 2, "secrets_scan": 3},
  "$defs": {
    "envelope": {
      "type": "object",
      "required": [
        "outcome"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "done",
            "error"
          ]
        },
        "error": {
          "type": "string",
          "maxLength": 300
        },
        "summary": {
          "type": "string",
          "maxLength": 300
        }
      }
    },
    "port": {
      "type": "object",
      "required": [
        "number"
      ],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "protocol": {
          "enum": [
            "tcp",
            "udp"
          ]
        },
        "state": {
          "enum": [
            "open",
            "closed",
            "filtered"
          ]
        },
        "service_name": {
          "type": "string",
          "maxLength": 64
        },
        "product": {
          "type": "string",
          "maxLength": 120
        },
        "version": {
          "type": "string",
          "maxLength": 80
        }
      }
    },
    "finding": {
      "type": "object",
      "properties": {
        "template_id": {
          "type": "string",
          "maxLength": 80
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "severity": {
          "enum": [
            "info",
            "low",
            "medium",
            "high",
            "critical",
            "unknown"
          ]
        },
        "host": {
          "type": "string",
          "maxLength": 260
        },
        "matched_at": {
          "type": "string",
          "maxLength": 500
        },
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "matcher_name": {
          "type": "string",
          "maxLength": 80
        },
        "extracted_results": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 300
          }
        },
        "tags": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 40
          }
        },
        "cve_ids": {
          "description": "Optional: the CVE ids the template names (nuclei's classification.cve-id). Only well-formed ids are kept; a result without the field is stored without it.",
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "pattern": "^[Cc][Vv][Ee]-[0-9]{4}-[0-9]{4,7}$"
          }
        },
        "type": {
          "description": "Optional (1.3.5): nuclei's protocol type of the template (its \"type\" field). The server keeps it, lowercased, when it is one of http, tcp, network, javascript, dns, ssl, headless, file, whois, code or websocket, and drops any other value.",
          "type": "string",
          "maxLength": 40
        },
        "request": {
          "description": "Optional (1.3.5): the request the template sent when it matched. The server keeps the first 4096 characters, control bytes but not newlines removed.",
          "type": "string"
        },
        "response": {
          "description": "Optional (1.3.5): the answer that matched. The server keeps the first 4096 characters, control bytes but not newlines removed.",
          "type": "string"
        }
      }
    },
    "results": {
      "nmap": {
        "allOf": [
          {
            "$ref": "#/$defs/envelope"
          },
          {
            "type": "object",
            "properties": {
              "hosts": {
                "type": "array",
                "maxItems": 64,
                "items": {
                  "type": "object",
                  "required": [
                    "ip"
                  ],
                  "properties": {
                    "ip": {
                      "type": "string",
                      "maxLength": 60
                    },
                    "os_guess": {
                      "type": "string",
                      "maxLength": 120
                    },
                    "ports": {
                      "type": "array",
                      "maxItems": 500,
                      "items": {
                        "$ref": "#/$defs/port"
                      }
                    }
                  }
                }
              },
              "os_reliable": {
                "type": "boolean",
                "description": "send the literal false on Docker Desktop; anything else means reliable"
              }
            }
          }
        ]
      },
      "naabu": {
        "allOf": [
          {
            "$ref": "#/$defs/envelope"
          },
          {
            "type": "object",
            "properties": {
              "ports": {
                "type": "object",
                "maxProperties": 64,
                "additionalProperties": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "items": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  }
                }
              }
            }
          }
        ]
      },
