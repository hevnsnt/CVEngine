                      ]
                    },
                    "finding": {
                      "type": "string",
                      "maxLength": 600
                    },
                    "cve": {
                      "type": "string",
                      "maxLength": 300
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "nmap_udp": {
        "allOf": [
          {
            "$ref": "#/$defs/envelope"
          },
          {
            "type": "object",
            "properties": {
              "xml": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4194304
              }
            }
          }
        ]
      },
      "wpscan": {
        "allOf": [
          {
            "$ref": "#/$defs/envelope"
          },
          {
            "type": "object",
            "properties": {
              "report": {
                "type": [
                  "object",
                  "null"
                ],
                "description": "the raw WPScan JSON report; at most 8 MiB serialised"
              },
              "returncode": {
                "type": "integer"
              },
              "stderr_tail": {
                "type": "string",
                "maxLength": 300
              }
            }
          }
        ]
      },
      "discover": {
        "allOf": [
          {
            "$ref": "#/$defs/envelope"
          },
          {
            "type": "object",
            "properties": {
              "hosts": {
                "type": "array",
                "maxItems": 512,
                "items": {
                  "type": "object",
                  "required": [
                    "ip"
                  ],
                  "properties": {
                    "ip": {
                      "type": "string",
                      "maxLength": 60
                    },
                    "hostnames": {
                      "type": "array",
                      "maxItems": 5,
                      "items": {
                        "type": "string",
                        "maxLength": 260
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "openvas": {
        "allOf": [
          {
            "$ref": "#/$defs/envelope"
          },
          {
            "type": "object",
            "properties": {
              "results": {
                "type": "array",
                "maxItems": 5000,
                "items": {
                  "type": "object",
                  "required": [
                    "oid",
                    "address"
                  ],
                  "properties": {
                    "oid": {
                      "type": "string",
                      "pattern": "^[0-9.]{3,64}$"
                    },
                    "name": {
                      "type": "string",
                      "maxLength": 300
                    },
                    "family": {
                      "type": "string",
                      "maxLength": 100
                    },
                    "address": {
                      "type": "string",
                      "maxLength": 60
                    },
                    "hostname": {
                      "type": "string",
                      "maxLength": 255
                    },
                    "port": {
                      "type": "string",
                      "pattern": "^[0-9]{1,5}/(tcp|udp)$"
                    },
                    "severity": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 10
                    },
                    "threat": {
                      "type": "string",
                      "maxLength": 20
                    },
                    "qod": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 100
                    },
                    "qod_type": {
                      "type": "string",
                      "maxLength": 40
                    },
                    "result": {
                      "type": "string",
                      "maxLength": 2000
                    },
                    "summary": {
                      "type": "string",
                      "maxLength": 1500
                    },
                    "insight": {
                      "type": "string",
                      "maxLength": 1500
                    },
                    "impact": {
                      "type": "string",
                      "maxLength": 1500
                    },
                    "affected": {
                      "type": "string",
                      "maxLength": 800
                    },
                    "solution": {
                      "type": "string",
                      "maxLength": 1500
                    },
                    "solution_type": {
                      "type": "string",
                      "maxLength": 30
                    },
                    "cvss_vector": {
                      "type": "string",
                      "maxLength": 200
                    },
                    "cves": {
                      "type": "array",
                      "maxItems": 50,
                      "items": {
                        "type": "string",
                        "maxLength": 40
                      }
                    },
                    "urls": {
                      "type": "array",
                      "maxItems": 20,
                      "items": {
                        "type": "string",
                        "maxLength": 500
                      }
                    }
                  }
                }
              },
              "scanned_addresses": {
                "type": "array",
                "maxItems": 64,
                "items": {
                  "type": "string",
                  "maxLength": 60
                }
              },
              "without_cve": {
                "type": "integer",
                "minimum": 0
              },
              "unusable": {
                "type": "integer",
                "minimum": 0
              },
              "partial": {
                "type": "boolean"
              }
            }
          }
        ]
      },
      "waf": {
        "allOf": [
          {
            "$ref": "#/$defs/envelope"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "outcome": true,
              "error": true,
              "summary": true,
              "products": {
                "type": "array",
                "maxItems": 20,
                "items": {
                  "type": "object",
                  "required": [
                    "name"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "manufacturer": {
                      "type": "string",
                      "maxLength": 100,
                      "description": "informational: cvENGINE stores the product, as a local wafw00f run does, not who makes it"
                    }
                  }
                }
              },
              "generic": {
                "type": "boolean",
                "description": "something blocked the probes but wafw00f could name no product"
              }
            },
            "if": {
              "properties": {
                "outcome": {
                  "const": "done"
                }
              },
              "required": [
                "outcome"
              ]
            },
            "then": {
              "required": [
                "products",
                "generic"
              ]
            }
          }
        ]
      },
      "secrets_scan": {
        "allOf": [
          {
            "$ref": "#/$defs/envelope"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "outcome": true,
              "error": true,
              "summary": true,
              "findings": {
                "type": "array",
                "maxItems": 500,
                "items": {
                  "type": "object",
                  "required": [
                    "rule_id",
                    "url",
                    "secret"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "rule_id": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9._:/-]{0,119}$"
                    },
                    "rule_name": {
                      "type": "string",
                      "maxLength": 200
                    },
                    "url": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    },
                    "line": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0
                    },
                    "confidence": {
                      "enum": [
                        "",
                        "low",
                        "medium",
                        "high"
                      ]
                    },
                    "entropy": {
                      "type": "string",
                      "maxLength": 20
                    },
                    "secret": {
                      "type": "string",
                      "minLength": 8,
                      "maxLength": 8192,
                      "description": "the value itself, over the authenticated channel only: the server fingerprints and masks it and never stores it"
                    },
                    "validation": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "outcome": {
                          "enum": [
                            "verified_active",
                            "assumed",
                            "locally_derived",
                            "invalid_material",
                            "verified_inactive",
                            "unavailable",
                            "skipped",
                            "not_attempted"
                          ]
                        }
                      },
                      "description": "Kingfisher's validation.outcome only: its response is never sent"
                    },
                    "validation_meta": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "restriction": {
                          "type": "string",
                          "maxLength": 60
                        },
                        "active_google_key": {
                          "type": "boolean"
                        },
                        "gemini_access": {
                          "type": [
                            "boolean",
                            "string"
                          ],
                          "maxLength": 60
                        },
                        "account_type": {
                          "type": "string",
                          "maxLength": 60
                        }
                      }
                    }
                  }
                }
              },
              "fetched": {
                "type": "array",
                "maxItems": 1000,
                "items": {
                  "type": "object",
                  "required": [
                    "url",
                    "kind"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "url": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    },
                    "status": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0,
                      "maximum": 999
                    },
                    "bytes": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "content_type": {
                      "type": "string",
                      "maxLength": 100
                    },
                    "kind": {
                      "enum": [
                        "page",
                        "script",
                        "sourcemap"
                      ]
                    },
                    "sourcemap_of": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    },
                    "sources_content": {
                      "type": "boolean",
                      "description": "a source map that embeds the original sources (sourcesContent)"
                    }
                  }
                }
              },
              "references": {
                "type": "array",
                "maxItems": 200,
                "items": {
                  "type": "object",
                  "required": [
                    "kind",
                    "value",
                    "url"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "enum": [
                        "s3",
                        "gcs",
                        "azure",
                        "firebase_rtdb",
                        "firebase_storage",
                        "gcr",
                        "ecr",
                        "ghcr",
                        "dockerhub",
                        "url"
                      ]
                    },
                    "value": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 255
                    },
                    "url": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    }
                  }
                }
              },
              "stats": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "files": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "findings": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "truncated": {
                    "type": "boolean"
                  },
                  "kingfisher_version": {
                    "type": "string",
                    "maxLength": 20
                  },
                  "rules_loaded": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "validated": {
                    "type": "boolean"
                  }
                }
              }
            },
            "if": {
              "properties": {
                "outcome": {
                  "const": "done"
                }
              },
              "required": [
                "outcome"
              ]
            },
            "then": {
              "required": [
                "findings",
                "fetched"
              ]
            }
          }
        ]
      }
    },
