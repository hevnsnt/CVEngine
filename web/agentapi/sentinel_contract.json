                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "testssl": {
        "allOf": [
          {
            "$ref": "#/$defs/envelope"
          },
          {
            "type": "object",
            "properties": {
              "items": {
                "type": "array",
                "maxItems": 300,
                "items": {
                  "type": "object",
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 60
                    },
                    "severity": {
                      "enum": [
                        "",
                        "INFO",
                        "LOW",
                        "MEDIUM",
                        "HIGH",
