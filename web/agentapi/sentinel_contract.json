        ],
        "additionalProperties": false,
        "properties": {
          "targets": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "string",
              "maxLength": 500
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
