          "etags",
          "template_policy"
        ],
        "additionalProperties": false,
        "properties": {
          "targets": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "string",
              "maxLength": 500
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 40
            }
          },
          "severities": {
            "type": "array",
            "items": {
              "enum": [
                "info",
                "low",
                "medium",
                "high",
                "critical",
                "unknown"
              ]
            }
          },
          "etags": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 40
            },
            "description": "tags the run must always exclude (dos)"
          },
          "template_policy": {
            "type": "object",
            "required": [
              "rev",
              "read_only",
              "bundle_sha256"
            ],
            "properties": {
              "rev": {
                "type": "string",
                "maxLength": 80
              },
              "read_only": {
                "type": "boolean"
              },
              "bundle_sha256": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      },
      "nuclei_deep": {
        "type": "object",
        "required": [
          "targets",
          "tags",
          "severities",
          "etags",
          "template_policy"
        ],
        "additionalProperties": false,
        "properties": {
          "targets": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "string",
              "maxLength": 500
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 40
            }
          },
          "severities": {
            "type": "array",
            "items": {
              "enum": [
                "info",
                "low",
                "medium",
