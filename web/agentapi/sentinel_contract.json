                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "testssl": {
        "allOf": [
          {
            "$ref": "#/$defs/envelope"
          },
          {
            "type": "object",
            "properties": {
              "items": {
                "type": "array",
                "maxItems": 300,
                "items": {
                  "type": "object",
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 60
                    },
                    "severity": {
                      "enum": [
                        "",
                        "INFO",
                        "LOW",
                        "MEDIUM",
                        "HIGH",
                        "CRITICAL",
                        "WARN",
                        "FATAL",
                        "DEBUG",
                        "OK"
                      ]
                    },
                    "finding": {
                      "type": "string",
                      "maxLength": 600
                    },
                    "cve": {
                      "type": "string",
                      "maxLength": 300
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "nmap_udp": {
        "allOf": [
          {
            "$ref": "#/$defs/envelope"
          },
          {
            "type": "object",
            "properties": {
              "xml": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4194304
              }
            }
          }
        ]
      },
      "wpscan": {
        "allOf": [
          {
            "$ref": "#/$defs/envelope"
          },
          {
            "type": "object",
            "properties": {
              "report": {
                "type": [
                  "object",
                  "null"
                ],
                "description": "the raw WPScan JSON report; at most 8 MiB serialised"
              },
              "returncode": {
                "type": "integer"
              },
              "stderr_tail": {
                "type": "string",
                "maxLength": 300
              }
            }
          }
        ]
      },
      "discover": {
        "allOf": [
          {
            "$ref": "#/$defs/envelope"
          },
          {
            "type": "object",
            "properties": {
              "hosts": {
                "type": "array",
                "maxItems": 512,
                "items": {
                  "type": "object",
                  "required": [
                    "ip"
                  ],
                  "properties": {
                    "ip": {
                      "type": "string",
                      "maxLength": 60
                    },
                    "hostnames": {
                      "type": "array",
                      "maxItems": 5,
                      "items": {
                        "type": "string",
                        "maxLength": 260
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "openvas": {
        "allOf": [
          {
            "$ref": "#/$defs/envelope"
          },
          {
            "type": "object",
            "properties": {
              "results": {
                "type": "array",
                "maxItems": 5000,
                "items": {
                  "type": "object",
                  "required": [
                    "oid",
                    "address"
                  ],
                  "properties": {
                    "oid": {
                      "type": "string",
                      "pattern": "^[0-9.]{3,64}$"
                    },
                    "name": {
                      "type": "string",
                      "maxLength": 300
                    },
                    "family": {
                      "type": "string",
                      "maxLength": 100
                    },
                    "address": {
                      "type": "string",
                      "maxLength": 60
                    },
                    "hostname": {
                      "type": "string",
                      "maxLength": 255
                    },
                    "port": {
                      "type": "string",
                      "pattern": "^[0-9]{1,5}/(tcp|udp)$"
                    },
                    "severity": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 10
                    },
                    "threat": {
                      "type": "string",
                      "maxLength": 20
                    },
                    "qod": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 100
                    },
                    "qod_type": {
                      "type": "string",
                      "maxLength": 40
                    },
                    "result": {
                      "type": "string",
                      "maxLength": 2000
                    },
                    "summary": {
                      "type": "string",
                      "maxLength": 1500
                    },
                    "insight": {
                      "type": "string",
                      "maxLength": 1500
                    },
                    "impact": {
                      "type": "string",
                      "maxLength": 1500
                    },
                    "affected": {
                      "type": "string",
                      "maxLength": 800
                    },
                    "solution": {
                      "type": "string",
                      "maxLength": 1500
                    },
                    "solution_type": {
                      "type": "string",
                      "maxLength": 30
                    },
                    "cvss_vector": {
                      "type": "string",
                      "maxLength": 200
                    },
                    "cves": {
                      "type": "array",
                      "maxItems": 50,
                      "items": {
                        "type": "string",
                        "maxLength": 40
                      }
                    },
                    "urls": {
                      "type": "array",
                      "maxItems": 20,
                      "items": {
                        "type": "string",
                        "maxLength": 500
                      }
                    }
                  }
                }
              },
              "scanned_addresses": {
                "type": "array",
                "maxItems": 64,
                "items": {
                  "type": "string",
                  "maxLength": 60
                }
              },
              "without_cve": {
                "type": "integer",
                "minimum": 0
              },
              "unusable": {
                "type": "integer",
                "minimum": 0
              },
              "partial": {
                "type": "boolean"
              }
            }
          }
        ]
      },
      "waf": {
        "allOf": [
          {
            "$ref": "#/$defs/envelope"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "outcome": true,
              "error": true,
              "summary": true,
              "products": {
                "type": "array",
                "maxItems": 20,
                "items": {
                  "type": "object",
                  "required": [
                    "name"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "manufacturer": {
                      "type": "string",
                      "maxLength": 100,
                      "description": "informational: cvENGINE stores the product, as a local wafw00f run does, not who makes it"
                    }
                  }
                }
              },
              "generic": {
                "type": "boolean",
                "description": "something blocked the probes but wafw00f could name no product"
              }
            },
            "if": {
              "properties": {
                "outcome": {
                  "const": "done"
                }
              },
              "required": [
                "outcome"
              ]
            },
            "then": {
              "required": [
                "products",
                "generic"
              ]
            }
          }
        ]
      },
      "http_probe": {
        "allOf": [
          {
            "$ref": "#/$defs/envelope"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "outcome": true,
              "error": true,
              "summary": true,
              "probes": {
                "type": "array",
                "maxItems": 300,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "observations": {
                      "type": "array",
                      "maxItems": 40,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "kind": {
                            "enum": [
                              "version",
                              "identity",
                              "edge",
                              "wordpress",
                              "wp-upgrade-dir"
                            ]
                          },
                          "product": {
                            "type": "string",
                            "maxLength": 120
                          },
                          "version": {
                            "type": "string",
                            "maxLength": 100
                          },
                          "variant": {
                            "type": "string",
                            "maxLength": 60
                          },
                          "outcome": {
                            "enum": [
                              "found",
                              "hidden",
                              "absent",
                              "challenged",
                              "edge"
                            ]
                          },
                          "confidence": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                          },
                          "source": {
                            "type": "string",
                            "maxLength": 48
                          },
                          "port": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 65535
                          },
                          "url": {
                            "type": "string",
                            "maxLength": 500
                          },
                          "evidence": {
                            "type": "object",
                            "description": "what the probe read (signals, the library record); at most 16 KB as JSON"
                          }
                        },
                        "required": [
                          "kind",
                          "product",
                          "outcome",
                          "confidence",
                          "source"
                        ]
                      }
                    },
                    "error": {
                      "type": "string",
                      "maxLength": 200
                    }
                  },
                  "required": [
                    "id",
                    "observations"
                  ]
                }
              },
              "touched": {
                "type": "array",
                "maxItems": 2000,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 260
                },
                "description": "every host a request was sent to"
              },
              "refused": {
                "type": "array",
                "maxItems": 2000,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 260
                },
                "description": "every host a hop (a redirect, a script) was refused for by the scope policy"
              }
            },
            "if": {
              "properties": {
                "outcome": {
                  "const": "done"
                }
              },
              "required": [
                "outcome"
              ]
            },
            "then": {
              "required": [
                "probes",
                "touched"
              ]
            }
          }
        ]
      },
      "dns_resolve": {
        "allOf": [
          {
            "$ref": "#/$defs/envelope"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "outcome": true,
              "error": true,
              "summary": true,
              "resolved": {
                "type": "object",
                "maxProperties": 500,
                "propertyNames": {
                  "maxLength": 253
                },
                "additionalProperties": {
                  "type": "array",
                  "maxItems": 32,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60
                  },
                  "minItems": 1
                },
                "description": "every address each name answered, as answered: the server judges them"
              },
              "errors": {
                "type": "object",
                "maxProperties": 500,
                "propertyNames": {
                  "maxLength": 253
                },
                "additionalProperties": {
                  "type": "string",
                  "maxLength": 120
                },
                "description": "a lookup the resolver could not answer (never a name without an address)"
              },
              "refused": {
                "type": "array",
                "maxItems": 500,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 253
                }
              }
            },
            "if": {
              "properties": {
                "outcome": {
                  "const": "done"
                }
              },
              "required": [
                "outcome"
              ]
            },
            "then": {
              "required": [
                "resolved",
                "errors"
              ]
            }
          }
        ]
      }
    },
    "targets": {
