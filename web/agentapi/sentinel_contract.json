{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hevnsnt/CVEngine/agentapi/sentinel_contract.json",
  "title": "cvENGINE Sentinel result contract",
  "description": "Both halves of the exchange between cvENGINE and a Sentinel. $defs/targets is what the server hands a Sentinel for each task kind (the task's target); $defs/results is what a Sentinel sends to POST /api/v1/sentinel/tasks/{id}/result. The server clips and validates every result anyway (agentapi.sentinel_broker.clean_result); this file is what a correct client keeps to, so the server never has to. Bounds are asserted equal to the server's own limits, and every target the server builds is validated against it, by tests/test_sentinel_contract.py. Bump contract_version (and say so in CHANGELOG) for any change a client must follow.",
  "contract_version": 2,
  "min_supported_contract_version": 1,
  "kind_since": {"nmap": 1, "naabu": 1, "nuclei_light": 1, "nuclei_targeted": 1, "nuclei_deep": 1, "testssl": 1, "nmap_udp": 1, "wpscan": 1, "discover": 1, "openvas": 1, "waf": 2},
  "$defs": {
    "envelope": {
      "type": "object",
      "required": [
        "outcome"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "done",
            "error"
          ]
        },
        "error": {
          "type": "string",
          "maxLength": 300
        },
        "summary": {
          "type": "string",
          "maxLength": 300
        }
      }
    },
    "port": {
      "type": "object",
      "required": [
        "number"
      ],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "protocol": {
          "enum": [
            "tcp",
            "udp"
          ]
        },
        "state": {
          "enum": [
            "open",
            "closed",
            "filtered"
          ]
        },
        "service_name": {
          "type": "string",
          "maxLength": 64
        },
        "product": {
          "type": "string",
          "maxLength": 120
        },
        "version": {
          "type": "string",
          "maxLength": 80
        }
      }
    },
    "finding": {
      "type": "object",
      "properties": {
        "template_id": {
          "type": "string",
          "maxLength": 80
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "severity": {
          "enum": [
            "info",
            "low",
            "medium",
            "high",
            "critical",
            "unknown"
          ]
        },
        "host": {
          "type": "string",
          "maxLength": 260
        },
        "matched_at": {
          "type": "string",
          "maxLength": 500
        },
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "matcher_name": {
          "type": "string",
          "maxLength": 80
        },
        "extracted_results": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 300
          }
        },
        "tags": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 40
          }
        }
      }
    },
    "results": {
      "nmap": {
        "allOf": [
          {
            "$ref": "#/$defs/envelope"
          },
          {
            "type": "object",
            "properties": {
              "hosts": {
                "type": "array",
                "maxItems": 64,
                "items": {
                  "type": "object",
                  "required": [
                    "ip"
                  ],
                  "properties": {
                    "ip": {
                      "type": "string",
                      "maxLength": 60
                    },
                    "os_guess": {
                      "type": "string",
                      "maxLength": 120
                    },
                    "ports": {
                      "type": "array",
                      "maxItems": 500,
                      "items": {
                        "$ref": "#/$defs/port"
                      }
                    }
                  }
                }
              },
              "os_reliable": {
                "type": "boolean",
                "description": "send the literal false on Docker Desktop; anything else means reliable"
              }
            }
          }
        ]
      },
      "naabu": {
        "allOf": [
          {
            "$ref": "#/$defs/envelope"
          },
          {
            "type": "object",
            "properties": {
              "ports": {
                "type": "object",
                "maxProperties": 64,
                "additionalProperties": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "items": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  }
                }
              }
            }
          }
        ]
      },
      "nuclei_light": {
        "allOf": [
          {
            "$ref": "#/$defs/envelope"
          },
          {
            "type": "object",
            "required": [
              "findings"
            ],
            "properties": {
              "findings": {
                "type": "array",
                "maxItems": 5000,
                "items": {
                  "type": "object",
                  "properties": {
                    "template_id": {
                      "type": "string",
                      "maxLength": 80
                    },
                    "name": {
                      "type": "string",
                      "maxLength": 200
                    },
                    "severity": {
                      "enum": [
                        "info",
                        "low",
                        "medium",
                        "high",
                        "critical",
                        "unknown"
                      ]
                    },
                    "host": {
                      "type": "string",
                      "maxLength": 260
                    },
                    "matched_at": {
                      "type": "string",
                      "maxLength": 500
                    },
                    "description": {
                      "type": "string",
                      "maxLength": 500
                    },
                    "matcher_name": {
                      "type": "string",
                      "maxLength": 80
                    },
                    "extracted_results": {
                      "type": "array",
                      "maxItems": 20,
                      "items": {
                        "type": "string",
                        "maxLength": 300
                      }
                    },
                    "tags": {
                      "type": "array",
                      "maxItems": 20,
                      "items": {
                        "type": "string",
                        "maxLength": 40
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "nuclei_targeted": {
        "allOf": [
          {
            "$ref": "#/$defs/envelope"
          },
          {
            "type": "object",
            "required": [
              "findings"
            ],
            "properties": {
              "findings": {
                "type": "array",
                "maxItems": 5000,
                "items": {
                  "type": "object",
                  "properties": {
                    "template_id": {
                      "type": "string",
                      "maxLength": 80
                    },
                    "name": {
                      "type": "string",
                      "maxLength": 200
                    },
                    "severity": {
                      "enum": [
                        "info",
                        "low",
                        "medium",
                        "high",
                        "critical",
                        "unknown"
                      ]
                    },
                    "host": {
                      "type": "string",
                      "maxLength": 260
                    },
                    "matched_at": {
                      "type": "string",
                      "maxLength": 500
                    },
                    "description": {
                      "type": "string",
                      "maxLength": 500
                    },
                    "matcher_name": {
                      "type": "string",
                      "maxLength": 80
                    },
                    "extracted_results": {
                      "type": "array",
                      "maxItems": 20,
                      "items": {
                        "type": "string",
                        "maxLength": 300
                      }
                    },
                    "tags": {
                      "type": "array",
                      "maxItems": 20,
                      "items": {
                        "type": "string",
                        "maxLength": 40
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "nuclei_deep": {
        "allOf": [
          {
            "$ref": "#/$defs/envelope"
          },
          {
            "type": "object",
            "required": [
              "findings"
            ],
            "properties": {
              "findings": {
                "type": "array",
                "maxItems": 5000,
                "items": {
                  "type": "object",
                  "properties": {
                    "template_id": {
                      "type": "string",
                      "maxLength": 80
                    },
                    "name": {
                      "type": "string",
                      "maxLength": 200
                    },
                    "severity": {
                      "enum": [
                        "info",
                        "low",
                        "medium",
                        "high",
                        "critical",
                        "unknown"
                      ]
                    },
                    "host": {
                      "type": "string",
                      "maxLength": 260
                    },
                    "matched_at": {
                      "type": "string",
                      "maxLength": 500
                    },
                    "description": {
                      "type": "string",
                      "maxLength": 500
                    },
                    "matcher_name": {
                      "type": "string",
                      "maxLength": 80
                    },
                    "extracted_results": {
                      "type": "array",
                      "maxItems": 20,
                      "items": {
                        "type": "string",
                        "maxLength": 300
                      }
                    },
                    "tags": {
                      "type": "array",
                      "maxItems": 20,
                      "items": {
                        "type": "string",
                        "maxLength": 40
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "testssl": {
        "allOf": [
          {
            "$ref": "#/$defs/envelope"
          },
          {
            "type": "object",
            "properties": {
              "items": {
                "type": "array",
                "maxItems": 300,
                "items": {
                  "type": "object",
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 60
                    },
                    "severity": {
                      "enum": [
                        "",
                        "INFO",
                        "LOW",
                        "MEDIUM",
                        "HIGH",
                        "CRITICAL",
                        "WARN",
                        "FATAL",
                        "DEBUG",
                        "OK"
                      ]
                    },
                    "finding": {
                      "type": "string",
                      "maxLength": 600
                    },
                    "cve": {
                      "type": "string",
                      "maxLength": 300
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "nmap_udp": {
        "allOf": [
          {
            "$ref": "#/$defs/envelope"
          },
          {
            "type": "object",
            "properties": {
              "xml": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4194304
              }
            }
          }
        ]
      },
      "wpscan": {
        "allOf": [
          {
            "$ref": "#/$defs/envelope"
          },
          {
            "type": "object",
            "properties": {
              "report": {
                "type": [
                  "object",
                  "null"
                ],
                "description": "the raw WPScan JSON report; at most 8 MiB serialised"
              },
              "returncode": {
                "type": "integer"
              },
              "stderr_tail": {
                "type": "string",
                "maxLength": 300
              }
            }
          }
        ]
      },
      "discover": {
        "allOf": [
          {
            "$ref": "#/$defs/envelope"
          },
          {
            "type": "object",
            "properties": {
              "hosts": {
                "type": "array",
                "maxItems": 512,
                "items": {
                  "type": "object",
                  "required": [
                    "ip"
                  ],
                  "properties": {
                    "ip": {
                      "type": "string",
                      "maxLength": 60
                    },
                    "hostnames": {
                      "type": "array",
                      "maxItems": 5,
                      "items": {
                        "type": "string",
                        "maxLength": 260
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "openvas": {
        "allOf": [
          {
            "$ref": "#/$defs/envelope"
          },
          {
            "type": "object",
            "properties": {
              "results": {
                "type": "array",
                "maxItems": 5000,
                "items": {
                  "type": "object",
                  "required": [
                    "oid",
                    "address"
                  ],
                  "properties": {
                    "oid": {
                      "type": "string",
                      "pattern": "^[0-9.]{3,64}$"
                    },
                    "name": {
                      "type": "string",
                      "maxLength": 300
                    },
                    "family": {
                      "type": "string",
                      "maxLength": 100
                    },
                    "address": {
                      "type": "string",
                      "maxLength": 60
                    },
                    "hostname": {
                      "type": "string",
                      "maxLength": 255
                    },
                    "port": {
                      "type": "string",
                      "pattern": "^[0-9]{1,5}/(tcp|udp)$"
                    },
                    "severity": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 10
                    },
                    "threat": {
                      "type": "string",
                      "maxLength": 20
                    },
                    "qod": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 100
                    },
                    "qod_type": {
                      "type": "string",
                      "maxLength": 40
                    },
                    "result": {
                      "type": "string",
                      "maxLength": 2000
                    },
                    "summary": {
                      "type": "string",
                      "maxLength": 1500
                    },
                    "insight": {
                      "type": "string",
                      "maxLength": 1500
                    },
                    "impact": {
                      "type": "string",
                      "maxLength": 1500
                    },
                    "affected": {
                      "type": "string",
                      "maxLength": 800
                    },
                    "solution": {
                      "type": "string",
                      "maxLength": 1500
                    },
                    "solution_type": {
                      "type": "string",
                      "maxLength": 30
                    },
                    "cvss_vector": {
                      "type": "string",
                      "maxLength": 200
                    },
                    "cves": {
                      "type": "array",
                      "maxItems": 50,
                      "items": {
                        "type": "string",
                        "maxLength": 40
                      }
                    },
                    "urls": {
                      "type": "array",
                      "maxItems": 20,
                      "items": {
                        "type": "string",
                        "maxLength": 500
                      }
                    }
                  }
                }
              },
              "scanned_addresses": {
                "type": "array",
                "maxItems": 64,
                "items": {
                  "type": "string",
                  "maxLength": 60
                }
              },
              "without_cve": {
                "type": "integer",
                "minimum": 0
              },
              "unusable": {
                "type": "integer",
                "minimum": 0
              },
              "partial": {
                "type": "boolean"
              }
            }
          }
        ]
      },
      "waf": {
        "allOf": [
          {
            "$ref": "#/$defs/envelope"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "outcome": true,
              "error": true,
              "summary": true,
              "products": {
                "type": "array",
                "maxItems": 20,
                "items": {
                  "type": "object",
                  "required": [
                    "name"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "manufacturer": {
                      "type": "string",
                      "maxLength": 100,
                      "description": "informational: cvENGINE stores the product, as a local wafw00f run does, not who makes it"
                    }
                  }
                }
              },
              "generic": {
                "type": "boolean",
                "description": "something blocked the probes but wafw00f could name no product"
              }
            },
            "if": {
              "properties": {
                "outcome": {
                  "const": "done"
                }
              },
              "required": [
                "outcome"
              ]
            },
            "then": {
              "required": [
                "products",
                "generic"
              ]
            }
          }
        ]
      }
    },
    "targets": {
      "nmap": {
        "type": "object",
        "required": [
          "addresses"
        ],
        "additionalProperties": false,
        "properties": {
          "addresses": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "string",
              "maxLength": 60
            }
          }
        }
      },
      "naabu": {
        "type": "object",
        "required": [
          "addresses"
        ],
        "additionalProperties": false,
        "properties": {
          "addresses": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "string",
              "maxLength": 60
            }
          }
        }
      },
      "nuclei_light": {
        "type": "object",
        "required": [
          "targets",
          "tags",
          "severities",
          "etags",
          "template_policy"
        ],
        "additionalProperties": false,
        "properties": {
          "targets": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "string",
              "maxLength": 500
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 40
            }
          },
          "severities": {
            "type": "array",
            "items": {
              "enum": [
                "info",
                "low",
                "medium",
                "high",
                "critical",
                "unknown"
              ]
            }
          },
          "etags": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 40
            },
            "description": "tags the run must always exclude (dos)"
          },
          "template_policy": {
            "type": "object",
            "required": [
              "rev",
              "read_only",
              "bundle_sha256"
            ],
            "properties": {
              "rev": {
                "type": "string",
                "maxLength": 80
              },
              "read_only": {
                "type": "boolean"
              },
              "bundle_sha256": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      },
      "nuclei_targeted": {
        "type": "object",
        "required": [
          "targets",
          "tags",
