        "properties": {
          "hosts": {
            "type": "object",
            "description": "address to host name",
            "additionalProperties": {
              "type": "string",
              "maxLength": 260
            }
          },
          "excluded_families": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 100
            }
          },
          "max_hours": {
            "type": "number",
            "minimum": 0
          },
