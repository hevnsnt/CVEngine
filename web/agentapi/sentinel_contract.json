      "testssl": {
        "type": "object",
        "required": [
          "host",
          "ip",
          "port"
        ],
        "additionalProperties": false,
        "properties": {
          "host": {
            "type": "string",
            "maxLength": 260
          },
          "ip": {
            "type": "string",
            "maxLength": 60
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
